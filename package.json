{
  "name": "dsh-im-bridge",
  "version": "0.9.23",
  "description": "把 QQ 消息（文字/图片/文档/语音）转给本机 DSH 处理并回复的桥接服务，附带 DSH 设置页",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.4": "compatible"
      }
    }
  },
  "bin": {
    "dsh-im-bridge": "bin/bridge.mjs",
    "dsh-im-qqbot": "bin/qqbot.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/bridge.mjs",
    "selfcheck": "node scripts/selfcheck.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1772538871/dsh-im-bridge.git"
  },
  "files": [
    "lib",
    "src",
    "bin",
    "docs",
    "cordis.patch.yml",
    "bridge.config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "qq",
    "onebot",
    "napcat",
    "qqbot",
    "chatbot"
  ]
}
